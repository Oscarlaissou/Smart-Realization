# Base de données : Supabase uniquement (aucune base locale).
# Supabase > Project Settings > Database > Connection string > « Transaction pooler »
DATABASE_URL=postgresql://postgres.<ref-projet>:<mot-de-passe>@aws-1-eu-west-1.pooler.supabase.com:6543/postgres
SECRET_KEY=changez-moi

# Supabase Storage (images de la caméra) : Project Settings > API
SUPABASE_URL=https://<ref-projet>.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=camera

# Comptage des plants (modèle backend/models/mais.pt)
YOLO_ENABLED=true

# Broker MQTT (mesures des capteurs ESP32)
MQTT_ENABLED=false
MQTT_BROKER=localhost
MQTT_PORT=1883

# Notifications e-mail (smtplib)
NOTIFICATIONS_EMAIL_ACTIVES=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alertes@sevia.local

# Notifications SMS : "twilio" ou "africastalking"
NOTIFICATIONS_SMS_ACTIVES=false
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_FROM=SEVIA
